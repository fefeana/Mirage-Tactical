name: mirage_tactical_app
description: Mirage-Tactical - نظام حماية رقمية متكامل مع الذكاء الاصطناعي
publish_to: none
version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # ============================================================
  # 🌐 الشبكات والاتصال
  # ============================================================
  http: ^1.1.0
  dio: ^5.4.0
  web_socket_channel: ^2.4.0
  grpc: ^3.1.0
  retrofit: ^4.0.1
  retrofit_generator: ^7.0.8

  # ============================================================
  # 🗂️ التخزين المحلي
  # ============================================================
  shared_preferences: ^2.2.2
  sqflite: ^2.3.0
  hive: ^2.2.3
  hive_flutter: ^1.1.0
  objectbox: ^2.2.0
  objectbox_flutter_libs: ^2.2.0

  # ============================================================
  # 🔐 الأمان والتشفير
  # ============================================================
  jwt_decoder: ^2.0.1
  crypto: ^3.0.3
  pointycastle: ^3.7.3
  flutter_secure_storage: ^9.0.0
  encrypt: ^5.0.3
  cryptography: ^2.7.0

  # ============================================================
  # 🧠 إدارة الحالة (State Management)
  # ============================================================
  provider: ^6.0.5
  riverpod: ^2.4.0
  bloc: ^8.1.2
  flutter_bloc: ^8.1.3
  get_it: ^7.6.4
  hooks_riverpod: ^2.4.0

  # ============================================================
  # 🌿 البيئة والمتغيرات
  # ============================================================
  flutter_dotenv: ^5.1.0
  envied: ^0.3.0

  # ============================================================
  # 🎨 الواجهات والتصميم
  # ============================================================
  cupertino_icons: ^1.0.6
  flutter_svg: ^2.0.9
  lottie: ^2.7.0
  animations: ^2.0.7
  shimmer: ^3.0.0
  google_fonts: ^6.1.0
  flutter_spinkit: ^5.2.0
  animated_text_kit: ^4.2.2

  # ============================================================
  # 📱 الميزات المتقدمة
  # ============================================================
  camera: ^0.10.5
  image_picker: ^1.0.4
  file_picker: ^6.1.1
  permission_handler: ^11.0.1
  device_info_plus: ^9.1.0
  package_info_plus: ^4.2.0
  connectivity_plus: ^5.0.2
  share_plus: ^7.2.1
  url_launcher: ^6.2.1
  local_auth: ^2.1.7
  biometric_storage: ^5.0.0

  # ============================================================
  # 🧪 الاختبارات والتحليل
  # ============================================================
  firebase_core: ^2.24.2
  firebase_analytics: ^10.7.4
  firebase_crashlytics: ^3.4.9
  firebase_performance: ^0.9.3+9
  sentry_flutter: ^7.15.0

  # ============================================================
  # 🔔 الإشعارات
  # ============================================================
  flutter_local_notifications: ^16.3.0
  firebase_messaging: ^14.7.9
  awesome_notifications: ^0.8.2

  # ============================================================
  # 🌍 الترجمة والتعدد اللغوي
  # ============================================================
  intl: ^0.18.1
  easy_localization: ^3.0.3
  flutter_i18n: ^0.1.1

  # ============================================================
  # 📊 الرسوم البيانية والإحصائيات
  # ============================================================
  fl_chart: ^0.66.0
  syncfusion_flutter_charts: ^24.2.7

  # ============================================================
  # 📷 معالجة الصور والفيديو
  # ============================================================
  image: ^4.1.3
  video_player: ^2.8.1
  chewie: ^1.7.4

  # ============================================================
  # 🧩 أدوات مساعدة
  # ============================================================
  equatable: ^2.0.5
  json_annotation: ^4.8.1
  freezed_annotation: ^2.4.1
  collection: ^1.18.0
  synchronized: ^3.1.0
  clock: ^1.1.1
  universal_io: ^2.2.2

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^3.0.1

  # ============================================================
  # 🛠️ أدوات التطوير (Builders)
  # ============================================================
  build_runner: ^2.4.7
  json_serializable: ^6.7.1
  freezed: ^2.4.5
  hive_generator: ^2.0.1
  objectbox_generator: ^2.2.0

  # ============================================================
  # 🧪 أدوات الاختبار
  # ============================================================
  mockito: ^5.4.2
  network_image_mock: ^2.1.1

flutter:
  uses-material-design: true

  # 📁 الأصول (Assets) - يمكنك إضافة ملفاتك هنا
  # assets:
  #   - .env
  #   - assets/images/
  #   - assets/fonts/
  #   - assets/animations/
  #   - assets/icons/

  # 🖋️ الخطوط المخصصة - يمكنك إضافة خطوطك هنا
  # fonts:
  #   - family: MirageFont
  #     fonts:
  #       - asset: assets/fonts/MirageFont-Regular.ttf
  #       - asset: assets/fonts/MirageFont-Bold.ttf
  #         weight: 700
