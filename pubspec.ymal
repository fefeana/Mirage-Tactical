name: mirage_tactical
description: "ميراج التكتيكي - درع رقمي متكامل، VPN سريع وآمن، يعمل على أندرويد والويب مع ذكاء اصطناعي وكابلات بحرية وأقمار صناعية."
publish_to: 'none'
version: 1.0.0+1

# ============================================================
# بيئة التطوير (SDK)
# ============================================================
environment:
  sdk: '>=3.4.0 <4.0.0'

# ============================================================
# التبعيات الأساسية (Dependencies)
# ============================================================
dependencies:
  flutter:
    sdk: flutter

  # ----------------------------------------------------------
  # 1. إدارة الحالة (State Management)
  # ----------------------------------------------------------
  provider: ^6.1.1                 # إدارة الحالة الرئيسية
  flutter_riverpod: ^2.5.1         # بديل متقدم (للحالات المعقدة)
  get_it: ^7.7.0                   # حقن التبعيات (Dependency Injection)

  # ----------------------------------------------------------
  # 2. الشبكات والاتصالات
  # ----------------------------------------------------------
  http: ^1.2.0                     # طلبات HTTP بسيطة
  dio: ^5.4.0                      # عميل HTTP قوي مع اعتراضات
  grpc: ^3.2.0                     # اتصالات عالية الأداء (بديل WebSocket)
  protobuf: ^3.0.0                 # تبادل بيانات ثنائي (أسرع من JSON)
  web_socket_channel: ^2.4.0       # للتواصل في حالات الطوارئ
  connectivity_plus: ^6.0.3        # مراقبة حالة الإنترنت (للكابلات البديلة)

  # ----------------------------------------------------------
  # 3. التخزين والأمان
  # ----------------------------------------------------------
  shared_preferences: ^2.2.3       # تخزين الإعدادات البسيطة
  flutter_secure_storage: ^9.0.0   # تخزين آمن للمفاتيح (Keystore/Khchain)
  crypto: ^3.0.3                   # دوال تشفير مساعدة
  pointycastle: ^3.7.3             # خوارزميات تشفير متقدمة (ChaCha20, HKDF)

  # ----------------------------------------------------------
  # 4. النظام والأذونات
  # ----------------------------------------------------------
  permission_handler: ^11.3.0      # طلب أذونات النظام (VPN، الموقع، الإشعارات)
  device_info_plus: ^10.1.2        # الحصول على معلومات الجهاز
  package_info_plus: ^8.0.0        # الحصول على إصدار التطبيق
  url_launcher: ^6.3.0             # فتح روابط خارجية
  workmanager: ^0.5.1              # تشغيل مهام خلفية (تجديد المفاتيح)

  # ----------------------------------------------------------
  # 5. الموقع الجغرافي
  # ----------------------------------------------------------
  geolocator: ^13.0.1              # تحديد الموقع (لاختيار أقرب خادم MCP)

  # ----------------------------------------------------------
  # 6. الواجهة والتفاعل (UI/UX)
  # ----------------------------------------------------------
  go_router: ^14.2.0               # تنقل احترافي بين الشاشات
  flutter_svg: ^2.0.10             # عرض أيقونات SVG (للأدرع والأيقونات)
  lottie: ^3.1.2                   # رسوم متحركة JSON (حالة الاتصال)
  shimmer: ^3.0.0                  # تأثيرات تحميل جذابة
  flutter_staggered_animations: ^1.1.0  # حركات انتقالية أنيقة

  # ----------------------------------------------------------
  # 7. الإشعارات والتحليلات (Firebase)
  # ----------------------------------------------------------
  firebase_core: ^3.5.0            # جوهر Firebase
  firebase_analytics: ^11.3.3      # تحليلات الأداء
  firebase_remote_config: ^5.3.3   # إعدادات عن بُعد (مثل remote_config_defaults.xml)
  firebase_messaging: ^15.1.3      # إشعارات Push
  flutter_local_notifications: ^17.2.1  # إشعارات محلية

  # ----------------------------------------------------------
  # 8. التوافق مع المنصات (Web, Desktop)
  # ----------------------------------------------------------
  universal_platform: ^1.0.0+1     # الكشف عن المنصة (أندرويد، ويب، إلخ)
  universal_html: ^2.2.4           # بديل dart:io للويب
  win32: ^5.5.0                    # دعم Windows
  macos_ui: ^2.0.0                 # دعم macOS
  linux_embedded: ^0.1.0           # دعم Linux
  js: ^0.7.0                       # التفاعل مع JavaScript (للويب)

  # ----------------------------------------------------------
  # 9. التدويل واللغات
  # ----------------------------------------------------------
  flutter_localizations:
    sdk: flutter
  intl: ^0.19.0                    # دعم الترجمة والتنسيق

  # ----------------------------------------------------------
  # 10. أدوات مساعدة إضافية
  # ----------------------------------------------------------
  path_provider: ^2.1.3            # الوصول إلى مسارات الملفات
  file_picker: ^8.0.0              # اختيار الملفات من الجهاز
  image_picker: ^1.1.0             # اختيار الصور من المعرض
  qr_flutter: ^4.1.0               # توليد رموز QR
  share_plus: ^10.0.0              # مشاركة المحتوى

# ============================================================
# تبعيات التطوير (Dev Dependencies)
# ============================================================
dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^4.0.0             # قواعد كتابة كود نظيف
  build_runner: ^2.4.11            # توليد الكود (للـ gRPC و JSON)
  grpc_web: ^0.3.0                 # دعم gRPC على الويب
  json_serializable: ^6.8.0        # توليد serialization للـ JSON
  flutter_launcher_icons: ^0.13.1  # تغيير أيقونة التطبيق بسهولة

# ============================================================
# تكوين الأيقونة (Launcher Icons)
# ============================================================
flutter_launcher_icons:
  android: "launcher_icon"
  ios: true
  image_path: "assets/icons/mirage_logo.png"
  adaptive_icon_background: "#0A0A0A"
  adaptive_icon_foreground: "assets/icons/mirage_logo_foreground.png"

# ============================================================
# قسم Flutter الأساسي
# ============================================================
flutter:
  uses-material-design: true

  # ----------------------------------------------------------
  # الموارد (الأصول)
  # ----------------------------------------------------------
  assets:
    - assets/icons/                          # أيقونات التطبيق والأدرع
    - assets/images/                         # صور الخلفيات واللوجوهات
    - assets/fonts/                          # الخطوط المخصصة
    - assets/animations/                     # ملفات Lottie
    - assets/configs/servers_hub.json        # خريطة خوادم MCP
    - assets/configs/stealth_rules.json      # قواعد وضع "الشبح"
    - assets/configs/remote_config_defaults.xml  # الإعدادات الافتراضية
    - assets/configs/secure_routes.json      # المسارات الآمنة

  # ----------------------------------------------------------
  # الخطوط المخصصة
  # ----------------------------------------------------------
  fonts:
    - family: Samurai
      fonts:
        - asset: assets/fonts/Samurai-Regular.ttf
          weight: 400
        - asset: assets/fonts/Samurai-Bold.ttf
          weight: 700
        - asset: assets/fonts/Samurai-Italic.ttf
          weight: 400
          style: italic

    - family: MirageIcons
      fonts:
        - asset: assets/fonts/MirageIcons.ttf
          weight: 400

# ============================================================
# إعدادات التدويل (للملفات اللغوية)
# ============================================================
flutter_intl:
  enabled: true
  arb_dir: lib/l10n
  template_arb_file: lib/l10n/app_en.arb
  output_localization_file: app_localizations.dart
