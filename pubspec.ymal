name: mirage_tactical
description: "ميراج التكتيكي - VPN سريع وآمن"
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.4.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # ==========================================================
  # المكتبات المفقودة (أضفها فوراً)
  # ==========================================================
  provider: ^6.1.1
  http: ^1.2.0
  shared_preferences: ^2.2.3
  flutter_secure_storage: ^9.0.0

  # ==========================================================
  # المكتبات الأساسية الأخرى
  # ==========================================================
  grpc: ^3.2.0
  protobuf: ^3.0.0
  connectivity_plus: ^6.0.3
  web_socket_channel: ^2.4.0
  crypto: ^3.0.3
  pointycastle: ^3.7.3
  go_router: ^14.2.0
  flutter_svg: ^2.0.10
  lottie: ^3.1.2
  flutter_localizations:
    sdk: flutter
  intl: ^0.19.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0
  build_runner: ^2.4.11

flutter:
  uses-material-design: true
  assets:
    - assets/icons/
    - assets/images/
    - assets/fonts/
    - assets/animations/
    - assets/configs/
